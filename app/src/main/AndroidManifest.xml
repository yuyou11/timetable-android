<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 发通知。Android 13 起是运行时权限，必须动态申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 精确闹钟。
         USE_EXACT_ALARM：Android 13+ 自动授予，只给闹钟/日程类应用用（本应用属于此类）
         SCHEDULE_EXACT_ALARM：Android 12 用，需要用户在设置里手动开 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 开机后重建闹钟（闹钟保存在内存里，重启会丢） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 申请加入电池优化白名单，减少被系统冻结的概率 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Android 11 起有「软件包可见性」限制：App 默认看不见别的应用。
      想用系统时钟的「设置闹钟」能力（AlarmClock.ACTION_SET_ALARM），
      必须在这里声明我们认识这个 intent，否则系统会假装没有任何应用能处理它，
      表现为「点了没反应」而不是报错 —— 很难查。

      注意：这一项本来是为了隐私（防止 App 枚举你装了哪些软件），
      而这里只需要声明「我要用这个功能」，不需要任何权限。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Timetable">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 「用 AI 生成数据」向导。内部页面，不对外暴露 -->
        <activity
            android:name=".ui.GenerateGuideActivity"
            android:exported="false"
            android:label="@string/guide_title"
            android:parentActivityName=".MainActivity" />

        <!-- 闹钟到点时的入口。exported=false：只有系统（通过 PendingIntent）能触发它 -->
        <receiver
            android:name=".notify.AlarmReceiver"
            android:exported="false" />

        <!-- 通知按钮（暂停 / 关闭）的入口 -->
        <receiver
            android:name=".notify.ActionReceiver"
            android:exported="false" />

        <!-- 系统事件入口。这个必须是 exported=true，因为广播来自系统进程 -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
