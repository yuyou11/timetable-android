<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 发通知。Android 13 起是运行时权限，必须动态申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 响铃期间持有 CPU（MediaPlayer.setWakeMode）。
         只在响铃那几分钟持有；没有它，息屏后 CPU 睡下去，声音可能断掉 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 精确闹钟。
         USE_EXACT_ALARM：Android 13+ 自动授予，只给闹钟/日程类应用用（本应用属于此类）
         SCHEDULE_EXACT_ALARM：Android 12 用，需要用户在设置里手动开 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 开机后重建闹钟（闹钟保存在内存里，重启会丢） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 申请加入电池优化白名单，减少被系统冻结的概率 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 闹钟响时在**锁屏上直接弹出**「停止 / 贪睡」界面（闹钟类应用的标准用法）。
         拿不到这个权限也不会没有停止入口：通知上的两个按钮、划掉通知、
         以及 3 分钟自动停都还在，见 AlarmRinger 的说明。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Timetable">

        <!-- 主界面。桌面点图标直接进这里 —— 开屏动画已经去掉，
             没有中间那一层了（之前是 SplashActivity 播 1.6 秒再进来） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 「用 AI 生成数据」向导。内部页面，不对外暴露 -->
        <activity
            android:name=".ui.GenerateGuideActivity"
            android:exported="false"
            android:label="@string/guide_title"
            android:parentActivityName=".MainActivity" />

        <!-- 闹钟到点时的入口。exported=false：只有系统（通过 PendingIntent）能触发它 -->
        <receiver
            android:name=".notify.AlarmReceiver"
            android:exported="false" />

        <!-- 通知按钮（暂停 / 关闭）的入口 -->
        <receiver
            android:name=".notify.ActionReceiver"
            android:exported="false" />

        <!-- 系统事件入口。这个必须是 exported=true，因为广播来自系统进程 -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
