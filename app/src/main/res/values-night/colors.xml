<?xml version="1.0" encoding="utf-8"?>
<!--
  夜间的颜色覆盖。文件名里的 -night 就是资源限定符，
  和 CSS 的 @media (prefers-color-scheme: dark) 是同一个思路：
  **同一套 id，系统按当前环境自动挑一份**，代码里完全不用写 if。

  Android 的限定符比 CSS 丰富得多（-night 夜间、-land 横屏、
  -sw600dp 宽屏、-zh 中文…），而且可以叠加，比如 values-zh-rCN-night。
  优先级规则是「越具体的越优先」。

  ============================================================
  加了主题之后，这里变成了「两个维度」的组合
  ============================================================

    主题（蓝/绿）  ×  环境（日间/夜间）  =  四种情况

  巧的是这两个维度**天然正交**，所以不需要写四套：
  主题选哪套由 attrs.xml 的属性决定，日/夜由限定符决定，
  系统自动把它们组合起来。

  这就是为什么强调色要定义成「属性 + 具体色值」两层 ——
  属性负责「要哪一类」，色值负责「在这个环境下具体是什么」。
-->
<resources>
    <color name="app_bg">#101215</color>
    <color name="card_bg">#1B1E24</color>
    <color name="text_primary">#E8EAED</color>
    <color name="text_secondary">#9AA1AC</color>
    <color name="divider">#2A2F38</color>
    <color name="card_stroke">#262B34</color>
    <color name="chip_bg">#232830</color>
    <color name="on_accent">#101215</color>

    <!-- ========== 蓝（夜间） ==========
         夜间不能直接用日间那个 #1565C0 —— 深蓝压在深灰底上几乎看不见。
         所以要**调亮、略微降饱和**，让它从背景里浮出来又不刺眼。
    -->
    <color name="accent_blue">#6FB3F2</color>
    <color name="accent_soft_blue">#1B2E44</color>

    <!-- ========== 绿（夜间） ==========
         同理，日间的深绿 #2E7D32 在夜间等于看不见，换成 #81C784。

         这个值刻意压着饱和度（HSL 只有 39%）—— 夜间屏幕周围是黑的，
         高饱和的亮色会显得刺眼，而「不要荧光绿」在夜间的意义
         比白天更大。浅底座标绿也压得很暗，只比卡片背景亮一点点。
    -->
    <color name="accent_green">#81C784</color>
    <color name="accent_soft_green">#1B3220</color>

    <!-- ========== 青 / 紫 / 玫红 / 橙 / 红 / 靛蓝（夜间） ==========

         和蓝绿同一条规矩：夜间是**调亮 + 略降饱和**，不是把日间色直接搬过来。
         日间那批明度只有 25%~45%，压在 #101215 的深底上等于没有。

         浅底则相反：压到只比卡片背景（#1B1E24）亮一点点，当底色用不刺眼。
    -->
    <color name="accent_teal">#4DB6AC</color>
    <color name="accent_soft_teal">#12312E</color>

    <color name="accent_purple">#CE93D8</color>
    <color name="accent_soft_purple">#2E1B33</color>

    <color name="accent_pink">#F48FB1</color>
    <color name="accent_soft_pink">#331B26</color>

    <color name="accent_orange">#FFB74D</color>
    <color name="accent_soft_orange">#33260F</color>

    <color name="accent_red">#EF9A9A</color>
    <color name="accent_soft_red">#33191B</color>

    <color name="accent_indigo">#9FA8DA</color>
    <color name="accent_soft_indigo">#1D2140</color>
</resources>
