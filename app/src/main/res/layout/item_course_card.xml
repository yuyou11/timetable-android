<?xml version="1.0" encoding="utf-8"?>
<!--
  一张课程卡 —— 课表页点一格弹出来的面板里，一门课一张。

  结构固定（课名 + 徽标 + 一行「星期·节次」+ 时间/教室/老师/周次四条明细），
  按 WeekFragment 开头那条判据，固定结构写 XML；
  课表格子那种「随数据变」的才用代码生成。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <!-- 「本周 / 第 N 周 / 已停课」的小徽标。三种情况共用一个位置，
             默认藏起来，由 SlotCoursesCard 决定写什么 -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_duration_chip"
            android:includeFontPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="?attr/accentColor"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 星期·节次用强调色：和课表格子里的课名一个色系，
         「这张卡说的是哪一格」一眼对得上 -->
    <TextView
        android:id="@+id/tvWhen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:textColor="?attr/accentColor"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="2dp"
        android:background="@color/divider" />

    <!-- 四条明细。标签都是两个字，wrap_content 天然对齐成一列；
         取值列用 weight 吃掉剩余宽度，长教室名贴着标签排过去 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="时间"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowPlace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="教室"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- 教室用强调色，和今日页时间轴的地点行同款 -->
        <TextView
            android:id="@+id/tvPlace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:textColor="?attr/accentColor"
            android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowTeacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="老师"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvTeacher"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWeeksLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="周次"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvWeeks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- 备注：模板里每一格的第二行字（「周三有晚课，这觉必须睡」）。
         课程没有备注，这一行整块收起 —— 见 CardSheet.bindText -->
    <LinearLayout
        android:id="@+id/rowNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="备注"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- 「设置闹钟」：给这门课单独设一个课前提醒（只在这门课真的上的那几周才响）。
         自习卡没有课可绑，这一行会由 SlotCoursesCard 收起来 -->
    <TextView
        android:id="@+id/btnAlarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_prompt_box"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingVertical="10dp"
        android:text="@string/alarm_set"
        android:textColor="?attr/accentColor"
        android:textSize="13sp" />

</LinearLayout>
