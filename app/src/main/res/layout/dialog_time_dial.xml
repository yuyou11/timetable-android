<?xml version="1.0" encoding="utf-8"?>
<!--
  选时间的圆盘对话框：先小时、再分钟，各按一次「确定」才生效。

  刻意不用 AlertDialog 的按钮栏：那个按钮栏会把内容区压窄，
  而这张盘需要尽量大的直径 —— 260dp 是「一格 15°」还看得清的下限。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <com.yxz.timetable.ui.TimeDialView
        android:id="@+id/dial"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="?attr/accentSoftColor"
            android:text="取消"
            android:textColor="?attr/accentColor"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnOk"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:backgroundTint="?attr/accentColor"
            android:text="确定"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
