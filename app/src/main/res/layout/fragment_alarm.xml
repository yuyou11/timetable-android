<?xml version="1.0" encoding="utf-8"?>
<!--
  闹钟页。

  上半部分是那只自绘的钟（ClockView）—— 页面不能只有一列清单，
  而且「现在几点」正好是这个页面每次打开都要回答的第一个问题。
  下半部分是闹钟列表，用代码生成（条数随数据变，和课表网格同一个判据）。

  整页套一层 ScrollView：闹钟多了要能滚，横屏/小屏也不至于把「新建」按钮挤出去。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- 正在响铃：只要进程里还在响，这一条就冒出来。
              它是「声音关不掉」那个 bug 的最后一道保险，也是闹钟响时被拉起的
              那个窗口里唯一需要操作的东西 —— 所以「停止」做成实底大按钮，
              半梦半醒时不该找按钮。不响的时候整条 GONE，不占地方 -->
        <LinearLayout
            android:id="@+id/rowRinging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRinging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/alarm_ringing"
                android:textColor="?attr/accentColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRingStop"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/accentColor"
                    android:text="@string/alarm_ring_stop"
                    android:textColor="@color/on_accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRingSnooze"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/accentSoftColor"
                    android:text="@string/alarm_ring_snooze"
                    android:textColor="?attr/accentColor"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <com.yxz.timetable.ui.ClockView
            android:id="@+id/clock"
            android:layout_width="match_parent"
            android:layout_height="200dp" />

        <!-- 下一次响铃：这一行是这个页面最重要的一句话 -->
        <TextView
            android:id="@+id/tvNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="?attr/accentColor"
            android:textSize="12.5sp" />

        <!-- 节假日表没覆盖到的年份，在这里说明白（不提示的话用户会以为算错了） -->
        <TextView
            android:id="@+id/tvHolidayHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 该响却没响：错过提示。点一下表示知道了 -->
        <TextView
            android:id="@+id/tvMissed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_accent"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textColor="?attr/accentColor"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 会影响响铃的设置问题：通知权限、闹钟音量为 0 -->
        <TextView
            android:id="@+id/tvWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_accent"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textColor="?attr/accentColor"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <!-- 上次响铃：自动停之后也知道它响过 -->
        <TextView
            android:id="@+id/tvLastRang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="5dp"
            android:text="@string/alarm_empty"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_accent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/alarm_add"
            android:textColor="?attr/accentColor"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
