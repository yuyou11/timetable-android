<?xml version="1.0" encoding="utf-8"?>
<!--
  闹钟页。

  上半部分是那只自绘的钟（ClockView）—— 页面不能只有一列清单，
  而且「现在几点」正好是这个页面每次打开都要回答的第一个问题。
  下半部分是闹钟列表，用代码生成（条数随数据变，和课表网格同一个判据）。

  整页套一层 ScrollView：闹钟多了要能滚，横屏/小屏也不至于把「新建」按钮挤出去。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp">

        <com.yxz.timetable.ui.ClockView
            android:id="@+id/clock"
            android:layout_width="match_parent"
            android:layout_height="212dp" />

        <!-- 下一次响铃：这一行是这个页面最重要的一句话 -->
        <TextView
            android:id="@+id/tvNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="?attr/accentColor"
            android:textSize="13sp" />

        <!-- 节假日表没覆盖到的年份，在这里说明白（不提示的话用户会以为算错了） -->
        <TextView
            android:id="@+id/tvHolidayHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="4dp"
            android:text="@string/alarm_empty"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_prompt_box"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingVertical="12dp"
            android:text="@string/alarm_add"
            android:textColor="?attr/accentColor"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
