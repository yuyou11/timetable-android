<?xml version="1.0" encoding="utf-8"?>
<!--
  闹钟页 v4。

  结构：
    · heroLayer：固定在后面的表盘 + 数字钟 + 日期（heroInner 会随滚动整体上移）
    · scroll  ：透明滚动区。先放一个和视口等高的 spacer，后面才是白纸 sheet；
                滚动时白纸从下面盖上来，heroInner 只做 0.32 倍的上移。
    · rowRinging：响铃浮层，位置在 Fragment 里按高度算。

  ⚠️ heroInner 的位置 / 大小是量过的（393×800dp 基准）：
     表盘 260、top 120；数字钟 84sp、top 390；日期 top 492；竖线 top 522。
     改这里记得同时改 p3web/today 的样稿。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============================================================
         固定的表盘层
         ============================================================ -->
    <FrameLayout
        android:id="@+id/heroLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/heroInner"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 普通主题的钟 -->
            <com.yxz.timetable.ui.ClockView
                android:id="@+id/clock"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="130dp" />

            <!-- P3 的影时间表盘 -->
            <com.yxz.timetable.ui.persona.PersonaClockView
                android:id="@+id/personaClock"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="120dp"
                android:visibility="gone" />

            <!-- 黑边：Paint 只有一个颜色，描边和填色共用，单个 TextView 描不出黑边。
                 所以在下面垫一层放大的黑字，上面那层青字压住中间，露出来的就是硬边黑框
                 —— 和 PersonaMenuView 两遍 drawText 是同一个套路。 -->
            <TextView
                android:id="@+id/tvDigitalOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="390dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="22:07"
                android:textColor="#000000"
                android:textSize="84sp" />

            <TextView
                android:id="@+id/tvDigital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="390dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:shadowColor="#5502104A"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="1"
                android:text="22:07"
                android:textColor="?attr/accentColor"
                android:textSize="84sp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="510dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.18"
                android:maxLines="1"
                android:text="周三 · 第 8 周 · 10/27"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- 一条很细的时间线，把日期和下滑提示连起来 -->
            <View
                android:id="@+id/thread"
                android:layout_width="1dp"
                android:layout_height="80dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="540dp"
                android:background="@drawable/bg_thread"
                android:visibility="gone" />

            <!-- 「下滑 · 查看闹钟」必须和表盘 / 数字钟在同一层里一起上移。
                 它原来是 heroInner 的**兄弟**（直接挂在 heroLayer 上），于是
                 上滑时表盘走、这行字钉在原地，看起来像贴在屏幕底部没动。 -->
            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="40dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.22"
                android:lineSpacingExtra="6dp"
                android:text="下滑 · 查看闹钟"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />
        </FrameLayout>
    </FrameLayout>

    <!-- ============================================================
         透明的滚动区：spacer + 白纸
         ============================================================ -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 高度 = 视口高度，由 Fragment 在 layout 后写入 -->
            <View
                android:id="@+id/spacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_bg"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="22dp">

                <View
                    android:id="@+id/sheetTopLine"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/divider" />

                <!-- ============ 此刻卡：旧闹钟记录卡的三层背景 ============ -->
                <FrameLayout
                    android:id="@+id/nowCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_accent"
                    android:paddingStart="26dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvNowTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_time_bar"
                                android:includeFontPadding="false"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="5dp"
                                android:text="22:07"
                                android:textColor="@color/p3_ink"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvNowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.22"
                                android:text="此刻"
                                android:textColor="?attr/accentColor"
                                android:textSize="7sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="下次响铃"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="8sp" />

                                <TextView
                                    android:id="@+id/tvNowNext"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="06:40"
                                    android:textColor="@color/text_primary"
                                    android:textSize="34sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvNowLeft"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:layout_marginStart="8dp"
                                android:maxLines="1"
                                android:text="还有 8 小时 33 分"
                                android:textColor="?attr/accentColor"
                                android:textSize="8sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvNowMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="明天 · 周三 · 起床 · 工作日"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvHolidayHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMissed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_accent"
                    android:lineSpacingExtra="2dp"
                    android:padding="12dp"
                    android:textColor="?attr/accentColor"
                    android:textSize="11.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card_accent"
                    android:lineSpacingExtra="2dp"
                    android:padding="12dp"
                    android:textColor="?attr/accentColor"
                    android:textSize="11.5sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvListTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="闹钟"
                        android:textColor="@color/text_primary"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="长按跳过下一次"
                        android:textColor="@color/text_secondary"
                        android:textSize="7sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/alarm_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- ============ 新建闹钟：左青块 + 深藏青长条 ============ -->
                <LinearLayout
                    android:id="@+id/btnAdd"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_accent"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/addPlus"
                        android:layout_width="54dp"
                        android:layout_height="match_parent"
                        android:background="?attr/accentColor">

                        <ImageView
                            android:id="@+id/addIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/alarm_new_title"
                            android:src="@drawable/ic_plus"
                            android:tint="@color/on_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:id="@+id/addTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/alarm_new_title"
                            android:textColor="?attr/accentColor"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/addSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/alarm_new_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="7sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/addArrow"
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="11dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="?attr/accentColor" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLastRang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="7.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============================================================
         响铃浮层（位置由 Fragment 按高度写入）
         ============================================================ -->
    <LinearLayout
        android:id="@+id/rowRinging"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="500dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvRingTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.24"
            android:text="RINGING"
            android:textColor="?attr/accentColor"
            android:textSize="7sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRingTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="06:40"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRinging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/alarm_ringing_sub"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRingStop"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_accent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/alarm_ring_stop"
                android:textColor="?attr/accentColor"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRingSnooze"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/alarm_ring_snooze"
                android:textColor="?attr/accentColor"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnRingUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/alarm_ring_unlock"
            android:textColor="?attr/accentColor"
            android:textSize="8sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
