<?xml version="1.0" encoding="utf-8"?>
<!--
  LinearLayout + layout_weight 的配合，等价于 CSS 的 flex 布局：
    android:orientation="vertical"  ≈  flex-direction: column
    android:layout_weight="1"       ≈  flex: 1
    android:layout_height="0dp"     ≈  flex-basis: 0   ← 这一条很关键！

  为什么 weight 必须配 height=0dp？
  因为 weight 的算法是「先算完所有固定高度，再把剩余空间按权重分配」。
  如果写成 wrap_content，容器会先按内容撑一次，权重再分一次，结果不可预测。
  这跟 flex 里 flex-basis:auto 会导致内容撑开是同一个道理。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_menu" />

</LinearLayout>
