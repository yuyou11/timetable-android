<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义主题属性 —— 让「强调色」可以在运行时换。

  ============================================================
  为什么不能直接引用 @color/accent
  ============================================================
  布局里写 `@color/accent` 是**编译期就定死**的：资源表里那个 id
  指向一个具体颜色值，运行时改不了。想换色只能改颜色值本身。

  换成 `?attr/accentColor` 之后，它读的是**当前主题**里这个属性的取值。
  而主题是可以在 Activity 启动前用 setTheme() 换的 ——
  于是同一个布局文件在两套主题下就呈现出两种颜色。

  这和 CSS 里用变量声明颜色的思路一致：
  **布局不关心具体是什么颜色，只关心「这里该用强调色」。**

  （注：这段注释里本来写了 CSS 变量那个写法作为例子，
   但 XML 的注释**不允许出现连续的短横线** —— 那会撞上注释的结束标记。
   中文破折号没问题，ASCII 的双短横线不行。以后写注释记着点。）

  ## 为什么 accentSoft 要单独定义一个

  系统主题里有 colorPrimary，但没有「强调色的浅底色」这个语义。
  而本项目用 accent_soft 画选中态背景、当前格子背景 —— 它是
  **和 accent 配套**的一档颜色（浅底配深字），必须一起换，
  否则换了主色却留着蓝底，会很怪。
-->
<resources>
    <!-- 强调色：按钮、选中态、课程名、通知栏图标染色 -->
    <attr name="accentColor" format="color" />

    <!-- 强调色的浅底色：选中行背景、课表格子背景 -->
    <attr name="accentSoftColor" format="color" />
</resources>
