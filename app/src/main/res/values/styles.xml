<?xml version="1.0" encoding="utf-8"?>
<!--
  把重复的布局属性抽成 style，相当于 CSS 里的 class。
  好处是「权限自检」那四行的间距、字号只写一遍，改的时候也只需要改一处。
  Android 的 style 支持继承（parent），和 CSS 的层叠是一个思路。
-->
<resources>

    <style name="PermRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingVertical">10dp</item>
    </style>

    <style name="PermTextCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="PermTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PermStatus">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="PermButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="PermDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!--
      课表页「上一周 / 下一周」的圆形图标按钮。

      不使用 ?android:attr/borderlessButtonStyle：那个样式依赖主题解析，
      而且用文字当图标时会撞上「字体缺字形」的问题。
      这里给死尺寸、给死背景、给死 tint，渲染结果完全可预期。
    -->
    <style name="NavIconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_nav_button</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">?attr/accentColor</item>
    </style>

    <!--
      纯文字按钮。

      parent 明确写成 Widget.AppCompat.Button.Borderless 而不是
      ?android:attr/borderlessButtonStyle —— 后者在不同主题下解析到的东西不一样，
      文字颜色有几率变成和背景同色（表现就是「按钮不见了」）。
      这里把颜色写死，不再依赖主题。
    -->
    <style name="FlatTextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?attr/accentColor</item>
    </style>

</resources>
