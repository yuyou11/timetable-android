<?xml version="1.0" encoding="utf-8"?>
<!--
  把重复的布局属性抽成 style，相当于 CSS 里的 class。
  好处是「权限自检」那四行的间距、字号只写一遍，改的时候也只需要改一处。
  Android 的 style 支持继承（parent），和 CSS 的层叠是一个思路。
-->
<resources>

    <style name="PermRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="PermTextCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="PermTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PermStatus">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 次要按钮：浅强调色底 + 强调色字，比一排实心大按钮轻得多 -->
    <style name="TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/accentColor</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="PermButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="PermDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!--
      课表页「上一周 / 下一周」的圆形图标按钮。

      不使用 ?android:attr/borderlessButtonStyle：那个样式依赖主题解析，
      而且用文字当图标时会撞上「字体缺字形」的问题。
      这里给死尺寸、给死背景、给死 tint，渲染结果完全可预期。
    -->
    <style name="NavIconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_nav_button</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">?attr/accentColor</item>
    </style>

    <!--
      纯文字按钮。

      parent 明确写成 Widget.AppCompat.Button.Borderless 而不是
      ?android:attr/borderlessButtonStyle —— 后者在不同主题下解析到的东西不一样，
      文字颜色有几率变成和背景同色（表现就是「按钮不见了」）。
      这里把颜色写死，不再依赖主题。
    -->
    <style name="FlatTextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?attr/accentColor</item>
    </style>

    <!--
      课程详情卡（弹卡）的窗口动画：只要淡入淡出。

      「从被点的格子放大冒出来」是卡片自己用 ViewPropertyAnimator 做的
      （见 CourseDetailCard），窗口动画若再带平移或缩放，两套动作会叠加出
      奇怪的轨迹 —— 窗口这一层只管透明度，连背景压暗一起渐显 / 渐隐。
    -->
    <!-- ========== 文字层级 ==========
         全 App 只用这几档：22 标题 / 15 卡片标题 / 13 正文 / 12 次要 / 11 分区标签。
         之前是 10~23 之间随手定，同一个页面里出现四五种「差不多大」的字，
         看起来就散。 -->

    <!-- 分区标签：小、灰、拉开字距，只用来分段，不和正文抢注意力 -->
    <style name="SectionLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="CourseCardWindowAnim">
        <item name="android:windowEnterAnimation">@anim/course_card_fade_in</item>
        <item name="android:windowExitAnimation">@anim/course_card_fade_out</item>
    </style>

</resources>
